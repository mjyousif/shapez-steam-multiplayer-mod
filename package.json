{
    "name": "shapez-steam-multiplayer-mod",
    "version": "1.0.16",
    "description": "Steam-integrated Co-op Multiplayer Mod and IPC Bridge for shapez.io (v1.5.7)",
    "repository": {
        "type": "git",
        "url": "https://github.com/mjyousif/shapez-steam-multiplayer-mod.git"
    },
    "author": "mjyousif",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "build": "node scripts/build-bundle.js",
        "build:bundle": "node scripts/build-bundle.js",
        "build:native": "node scripts/build-native-p2p.js",
        "pretest": "node scripts/build-bundle.js && node -e \"if (!require('fs').existsSync('bin/steam_p2p_win64.node')) require('./scripts/build-native-p2p');\"",
        "prepackage": "node scripts/build-bundle.js && node -e \"if (!require('fs').existsSync('bin/steam_p2p_win64.node')) require('./scripts/build-native-p2p');\"",
        "install-mod": "node scripts/install-mod.js",
        "uninstall-mod": "node scripts/uninstall-mod.js",
        "backup-saves": "node scripts/backup-saves.js",
        "verify": "node scripts/verify-mod.js",
        "check:syntax": "node scripts/build-bundle.js && node scripts/check-syntax.js",
        "test:unit": "node --test",
        "test:e2e": "node scripts/verify-mod.js",
        "test": "node scripts/check-syntax.js && node --test && node scripts/verify-mod.js",
        "package": "node scripts/build-dist.js",
        "build-dist": "node scripts/build-dist.js",
        "launch-client": "node scripts/launch-coop-client.js"
    }
}
